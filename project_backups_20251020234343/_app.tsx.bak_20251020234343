import '@/styles/globals.css';
import type { AppProps } from 'next/app';
// ⭐ Necesitas esta importación para usar el contexto de sesión
import { SessionProvider } from 'next-auth/react'; 

// Renombramos a MyApp para seguir la convención común de Next.js
function MyApp({ Component, pageProps }: AppProps) {
  return (
    // ⭐ Envuelve toda la aplicación para acceder a la sesión
    <SessionProvider session={pageProps.session}>
      <Component {...pageProps} />
    </SessionProvider>
  );
}

export default MyApp; // Exporta solo la función principal